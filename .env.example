# Keep this file free of secrets. Copy values into your shell or secret manager.
EMAIL_AGENT_GMAIL_CLIENT_SECRET_PATH=/secure/path/google-client-secret.json
EMAIL_AGENT_GMAIL_TOKEN_PATH=/secure/path/gmail-token.json
EMAIL_AGENT_GMAIL_LABEL=AI_PROCESS
EMAIL_AGENT_DONE_LABEL=AI_DONE
EMAIL_AGENT_OWN_EMAIL=support@example.com
# Optional for a closed prototype mailbox:
# EMAIL_AGENT_ALLOWED_SENDER_DOMAIN=example.com
EMAIL_AGENT_STATE_DB=agent_state.db
EMAIL_AGENT_SEND_ENABLED=false
EMAIL_AGENT_MODEL_PROVIDER=rule_based
# Set these when EMAIL_AGENT_MODEL_PROVIDER is gemini or openrouter.
# EMAIL_AGENT_MODEL=...
# EMAIL_AGENT_MODEL_API_KEY=...
