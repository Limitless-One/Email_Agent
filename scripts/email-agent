#!/bin/sh
# Minimal local process controller for the NovaGear polling worker.
# It deliberately starts only `python3 -m email_agent poll`; Gmail access remains
# controlled by the credentials and EMAIL_AGENT_SEND_ENABLED settings in .env.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUNTIME_DIR="$ROOT/run"
PID_FILE="$RUNTIME_DIR/email-agent.pid"
LOG_FILE="$RUNTIME_DIR/email-agent.log"

is_running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE")
    kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
    start)
        if is_running; then
            echo "Email agent is already running (pid $(cat "$PID_FILE"))."
            exit 1
        fi
        rm -f "$PID_FILE"
        mkdir -p "$RUNTIME_DIR"
        (
            cd "$ROOT"
            nohup python3 -m email_agent poll >>"$LOG_FILE" 2>&1 &
            echo "$!" >"$PID_FILE"
        )
        echo "Email agent started (pid $(cat "$PID_FILE")). Log: $LOG_FILE"
        ;;
    stop)
        if ! is_running; then
            rm -f "$PID_FILE"
            echo "Email agent is not running."
            exit 0
        fi
        pid=$(cat "$PID_FILE")
        kill -TERM "$pid"
        rm -f "$PID_FILE"
        echo "Email agent stopped (pid $pid)."
        ;;
    status)
        if is_running; then
            echo "Email agent is running (pid $(cat "$PID_FILE"))."
        else
            rm -f "$PID_FILE"
            echo "Email agent is not running."
            exit 1
        fi
        ;;
    logs)
        [ -f "$LOG_FILE" ] || { echo "No log file yet: $LOG_FILE"; exit 0; }
        tail -n "${2:-100}" "$LOG_FILE"
        ;;
    *)
        echo "Usage: $0 {start|stop|status|logs [lines]}" >&2
        exit 2
        ;;
esac
